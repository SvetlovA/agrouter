# agrouter embedded defaults: the v1 catalog and argument mappings.
# Loaded with IgnoreInlineComment, so comments must be on their own lines.
# Override any key in ~/.config/agrouter/config (AGROUTER_CONFIG_DIR) or .agrouter/config;
# remove a section with enabled = false.

[agrouter]
# TypeSafe API key for Jev. Empty = no key. Prefer the env var or the global config;
# never put it in a local .agrouter/config that may be committed.
api_key   =
# pin a versioned id (e.g. jev-1.13.0) to keep routing stable across Jev releases
jev_model = jev-latest
# total routing budget: reading stdin and files, every Jev request (all chunks at once) and retries.
# cooperative: reading and network stop at it, splitting and encoding do not. raise it for very long inputs
timeout   = 10s

# question texts refer to JSON fields sent to Jev; these names are not substituted into the text.
# backticks mark field references for Jev. {prompt}, {model} and {value} substitutions belong
# to [cli.*.args] templates, not these questions.
# both routing questions receive eligible options as criteria, each with cli, model and effort.
# clis maps CLI names to descriptions; models maps model names to descriptions and prices;
# efforts maps each CLI name to its effort descriptions. these describe only eligible options.
# an option's model is the model to run the task; jev_model above is the model answering the questions.
# full encoding (used by routing evaluation) puts those descriptions directly in each criterion.

# question: the routing question for a state sent whole; tune the cost/quality preference here.
# state is the request's complete routing input:
# state.prompt is the joined -p, positional and --prompt-file text, followed by text stdin.
# state.files is an array of contents of readable text files mentioned in the prompt.
# state.attachments lists binary stdin and non-text mentioned files by source, media type and byte size;
# it contains neither their contents nor their names.
# state.project.complexity, when present, is the --doc stage's reduced codebase score from 0 to 10.
question  = Which coding-agent CLI, model and reasoning effort should run the task described in `state` (its `prompt`, the `files` the prompt mentions, and `attachments`, where `attachments` lists images, PDFs and other non-text inputs the task includes, by type and size only)? `project.complexity`, when present, rates the codebase the task runs in from 0 (a tiny script) to 10 (a large, constrained enterprise system): use it as context for how hard this specific task is there, not as a substitute for judging the task (a typo fix stays trivial in any codebase). Choose the option with the lowest cost that can reliably satisfy this task's requirements. Compare the supplied model prices and the effort descriptions, including their effect on token usage. Prefer cheaper options when their capabilities are sufficient. Choose a more expensive model or higher effort when it materially improves the likelihood of completing this specific task correctly. Prefer less time when cost and capability are comparable. Look up each option's `model` in `models`, its `cli` in `clis`, and its `effort` under that CLI in `efforts`.
# chunk_question: the routing question for one chunk of a split state: same options, same preference.
# state now contains anchor and chunk instead of the whole prompt and files.
# anchor is shared context repeated in every chunk request: prompt and file excerpts, attachment
# metadata and, when present, project.complexity. excerpts are whole strings or objects with head/tail.
# anchor.attachments may merge entries of the same source/type: count is their number, bytes their total.
# anchor.project.complexity is the same --doc score as state.project.complexity in a whole request.
# chunk.text is this chunk's text from the prompt or one mentioned file.
# chunk.field identifies its source as "prompt" or "files"; chunk.index is its 1-based position,
# and chunk.of is the total number of routing chunks. Jev sees only this chunk and the shared anchor.
chunk_question = Which coding-agent CLI, model and reasoning effort should run the task described by `anchor` and `chunk.text` together (`anchor.attachments` lists images, PDFs and other non-text inputs the task includes, by type and size only), where `chunk.text` is one part of a longer input? `anchor.project.complexity`, when present, rates the codebase the task runs in from 0 (a tiny script) to 10 (a large, constrained enterprise system): use it as context for how hard this specific task is there, not as a substitute for judging the task (a typo fix stays trivial in any codebase). Choose the option with the lowest cost that can reliably satisfy this task's requirements. Compare the supplied model prices and the effort descriptions, including their effect on token usage. Prefer cheaper options when their capabilities are sufficient. Choose a more expensive model or higher effort when it materially improves the likelihood of completing this specific task correctly. Prefer less time when cost and capability are comparable. Look up each option's `model` in `models`, its `cli` in `clis`, and its `effort` under that CLI in `efforts`.
# relevance: asked beside chunk_question, using the same anchor and chunk.text fields.
# its 0-to-1 answer measures how much this chunk adds task requirements beyond the anchor;
# that answer weights this chunk's routing probabilities when all chunk answers are pooled.
relevance = Does the text in `chunk.text` state the task to perform, its requirements, or what makes it hard, beyond what `anchor` already says?
# complexity_question: asked of --doc text before routing when at least one doc has text.
# state here contains only docs or doc, not the routing prompt, files, attachments or catalog.
# state.docs is an array of all non-empty --doc file contents, in supplied order, when they fit whole.
# state.doc.text is one chunk of one --doc file when the docs need splitting.
# state.doc.index is its 1-based position across all doc chunks; state.doc.of is their total count.
# the answer selects a project-complexity level from 0 to 10; its probabilities yield a numeric score.
complexity_question = How complex is the project that the docs in `state` describe (`docs`, or `doc.text` when it is one part of longer docs)? Judge the codebase as a whole: its size, architecture, dependencies and constraints, not any single task in it. Pick the level whose description fits the project best.
# complexity_evidence: asked beside complexity_question, using the same docs or doc.text fields.
# its 0-to-1 answer measures whether this text describes the codebase rather than only workflow/style;
# it weights this doc chunk's score when reducing the answers to project.complexity for routing.
complexity_evidence = Does the text in `state` (`docs` or `doc.text`) say anything about the project's size, architecture, dependencies or constraints?

[cli.claude]
command      = claude
description  = Claude Code (Anthropic). Agentic coding CLI with file editing, shell, subagents (Task tool) and MCP.

# how each agrouter argument is spelled for this CLI. A missing key = not supported:
# a call using it never routes to this CLI. [] = supported, adds nothing.
[cli.claude.args]
# required, always emitted first: non-interactive mode
print                        = ["-p"]
# required, always emitted last and only when there is a prompt: {prompt} = the -p, positional and --prompt-file text,
# after "--" so text starting with "-" is never parsed as a flag. claude -p reads stdin, and appends it after the prompt argument
prompt                       = ["--", "{prompt}"]
model                        = ["--model", "{model}"]
effort                       = ["--effort", "{effort}"]
# --dangerously-skip-permissions is agrouter's alias for this key
permission-mode.bypassPermissions = ["--dangerously-skip-permissions"]
permission-mode.plan         = ["--permission-mode", "plan"]
permission-mode.acceptEdits  = ["--permission-mode", "acceptEdits"]
permission-mode.auto         = ["--permission-mode", "auto"]
permission-mode.manual       = ["--permission-mode", "manual"]
permission-mode.dontAsk      = ["--permission-mode", "dontAsk"]
output-format.text           = ["--output-format", "text"]
output-format.json           = ["--output-format", "json"]
output-format.stream-json    = ["--output-format", "stream-json"]
verbose                      = ["--verbose"]

[cli.codex]
command      = codex
description  = Codex CLI (OpenAI). Agentic coding CLI with sandboxed shell, apply_patch and multi-agent spawn_agent.

[cli.codex.args]
print                        = ["exec"]
# codex exec reads stdin when no prompt argument is given, and appends it as a <stdin> block when one is
prompt                       = ["--", "{prompt}"]
model                        = ["--model", "{model}"]
# -c values are TOML; the quotes are part of the token (no shell)
effort                       = ["-c", "model_reasoning_effort=\"{effort}\""]
# --skip-git-repo-check (run outside a git repository) is a permission decision, so it lives here.
# approximate mappings: closest Codex setting, not equivalent. manual and dontAsk are absent: no counterpart
permission-mode.bypassPermissions = ["--dangerously-bypass-approvals-and-sandbox", "--skip-git-repo-check"]
permission-mode.plan         = ["--sandbox", "read-only", "-c", "approval_policy=\"never\"", "--skip-git-repo-check"]
permission-mode.acceptEdits  = ["--sandbox", "workspace-write"]
permission-mode.auto         = ["--approve-for-me"]
sandbox.read-only            = ["--sandbox", "read-only"]
sandbox.workspace-write      = ["--sandbox", "workspace-write"]
sandbox.danger-full-access   = ["--sandbox", "danger-full-access"]
# -c keys accepted, keyed by the part before "="; {value} = the whole key=value, byte-exact.
# exactly what ralphex sends
config.stream_idle_timeout_ms         = ["-c", "{value}"]
config.project_doc                    = ["-c", "{value}"]
config.project_doc_fallback_filenames = ["-c", "{value}"]
config.features.multi_agent           = ["-c", "{value}"]
config.agents.reviewer.description    = ["-c", "{value}"]
# only when --model / --effort is also given; otherwise these two -c keys are constraints
config.model                          = ["-c", "{value}"]
config.model_reasoning_effort         = ["-c", "{value}"]
# default output: final message on stdout. No single-result JSON: output-format.json is absent
output-format.text           = []
output-format.stream-json    = ["--json"]
verbose                      = []

# Claude models. Efforts match `claude --help` in Claude Code 2.1.283.
# Sources: https://platform.claude.com/docs/en/about-claude/models/overview
# and https://platform.claude.com/docs/en/about-claude/models/choosing-a-model

[model.claude-fable-5-1]
cli         = claude
# value substituted into {model}
name        = claude-fable-5-1
efforts     = low, medium, high, xhigh, max
description = Most capable model open to all customers. For demanding reasoning and long-horizon agentic work: multi-hour agent sessions, multistep deep research, analysis carried through to a finished document, spreadsheet or deck. Use when Opus 5.5 at higher effort still falls short. Slower; input USD 10 / output USD 50 per million tokens.
source      = https://platform.claude.com/docs/en/models/fable-5-1/overview

[model.claude-opus-5-5]
cli         = claude
name        = claude-opus-5-5
# other values --model accepts for this model; unique across the catalog
aliases     = opus
efforts     = low, medium, high, xhigh, max
description = For long-running agentic coding and knowledge work: multi-hour autonomous coding, large-scale refactoring, complex systems engineering, vision-heavy workflows. Recommended starting point for most workloads. Moderate latency; input USD 4 / output USD 20 per million tokens.
source      = https://platform.claude.com/docs/en/models/opus-5-5/overview

[model.claude-sonnet-5-5]
cli         = claude
name        = claude-sonnet-5-5
efforts     = low, medium, high, xhigh, max
description = Best combination of speed and intelligence. Everyday coding, code generation, data analysis, agentic tool use. Fast; input USD 2 / output USD 10 per million tokens.
source      = https://platform.claude.com/docs/en/models/sonnet-5-5/overview

[model.claude-haiku-4-5]
cli         = claude
name        = claude-haiku-4-5
# effort is not supported: one option, no effort flag
efforts     =
description = Fastest model with near-frontier intelligence. Real-time and high-volume processing, cost-sensitive work, subagent tasks. 200K context. Fastest; input USD 1 / output USD 5 per million tokens.
source      = https://platform.claude.com/docs/en/models/haiku-4-5/overview

# Claude effort levels. Source for all: https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.low]
description = Most efficient: significant token savings with some capability reduction. Simpler tasks that need speed and low cost, such as subagents.
source      = https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.medium]
description = Balanced, with moderate token savings. Agentic tasks balancing speed, cost and performance.
source      = https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.high]
description = Spends as many tokens as the task needs for excellent results. Complex reasoning, difficult coding problems, agentic tasks.
source      = https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.xhigh]
description = Extended capability for long-horizon work: long-running agentic and coding tasks (over 30 minutes).
source      = https://platform.claude.com/docs/en/build-with-claude/effort

[effort.claude.max]
description = Absolute maximum capability with no limit on token spending. The deepest reasoning; can overthink simple or structured tasks.
source      = https://platform.claude.com/docs/en/build-with-claude/effort

